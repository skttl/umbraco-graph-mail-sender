{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Umbraco.Community.GraphMailSender configuration",
  "type": "object",
  "properties": {
    "Umbraco": {
      "type": "object",
      "properties": {
        "CMS": {
          "type": "object",
          "properties": {
            "Global": {
              "type": "object",
              "properties": {
                "Smtp": {
                  "type": "object",
                  "properties": {
                    "Graph": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "TenantId": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Microsoft Entra tenant GUID."
                        },
                        "ClientId": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Entra application client GUID."
                        },
                        "ClientSecret": {
                          "type": "string",
                          "description": "Supply through a secret provider. Mutually exclusive with CertificatePath."
                        },
                        "CertificatePath": {
                          "type": "string",
                          "description": "Absolute PFX certificate path. Mutually exclusive with ClientSecret."
                        },
                        "CertificatePassword": {
                          "type": "string",
                          "description": "PFX password, supplied through a secret provider."
                        },
                        "Mailbox": {
                          "type": "string",
                          "description": "Target mailbox UPN/email or user object GUID."
                        }
                      },
                      "required": [
                        "TenantId",
                        "ClientId",
                        "Mailbox"
                      ],
                      "oneOf": [
                        {
                          "required": [
                            "ClientSecret"
                          ],
                          "not": {
                            "required": [
                              "CertificatePath"
                            ]
                          }
                        },
                        {
                          "required": [
                            "CertificatePath"
                          ],
                          "not": {
                            "required": [
                              "ClientSecret"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
