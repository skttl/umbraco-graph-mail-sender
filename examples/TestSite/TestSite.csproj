<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UserSecretsId>Umbraco.Community.GraphMailSender.TestSite</UserSecretsId>
    <CompressionEnabled>false</CompressionEnabled>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="13.0.0" Condition="'$(UmbracoMajor)' == '13'" />
    <PackageReference Include="Umbraco.Cms" Version="17.0.0" Condition="'$(UmbracoMajor)' == '17'" />
    <PackageReference Include="Umbraco.Cms" Version="18.0.0" Condition="'$(UmbracoMajor)' == '18'" />
    <ProjectReference Include="../../src/Umbraco.Community.GraphMailSender/Umbraco.Community.GraphMailSender.csproj" />
  </ItemGroup>
  <Import Project="../../buildTransitive/Umbraco.Community.GraphMailSender.targets" />
</Project>
